{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recall-context-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recall-context-plane",
      "database_id": "19581e6d-9a72-43df-b6e3-1d3718b2d268",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "recall-context-snapshots"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "recall-context-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "recall-context-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "recall-context-dead-letter"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_GATEWAY_ID": "recall-context",
    "AI_MODEL": "dynamic/recall-distill",
    "ENABLE_AI_DISTILLATION": "false",
    "RECEIPT_RETENTION_DAYS": "90"
  },
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
